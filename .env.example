# 复制为 .env 后按需修改；所有键以 SL_ 前缀对应 core/config.py
SL_POSTGRES_DSN=postgresql+psycopg://scholarlens:scholarlens@localhost:5432/scholarlens
SL_QDRANT_URL=http://localhost:6333
SL_NEO4J_URI=bolt://localhost:7687
SL_NEO4J_USER=neo4j
SL_NEO4J_PASSWORD=scholarlens
SL_MINIO_ENDPOINT=localhost:9000
SL_MINIO_ACCESS_KEY=minioadmin
SL_MINIO_SECRET_KEY=minioadmin
SL_REDIS_URL=redis://localhost:6379/0

# 模型（经 LiteLLM 路由，需另配各家 API key）
SL_STRONG_MODEL=claude-sonnet-4-5
SL_SMALL_MODEL=qwen-plus
SL_EMBEDDING_MODEL=BAAI/bge-m3
SL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

SL_JWT_SECRET=change-me-in-production

# 可观测（Langfuse 自托管）
# SL_LANGFUSE_HOST=http://localhost:3001
# SL_LANGFUSE_PUBLIC_KEY=
# SL_LANGFUSE_SECRET_KEY=

# MinerU 云解析 API token（在 https://mineru.net 的 API 管理页创建；只写在 .env，勿提交）
SL_MINERU_API_TOKEN=
